# demo: the backend reports demo mode and the frontend simulates the night itself.
# live: /api/scenario builds a real scenario from OpenSky + ERA5 + pycontrails.
UAL_MODE=demo

# Scenario window (UTC). Start hour and length in hours.
UAL_START=2026-10-10T21:00
UAL_HOURS=12
# lon_min,lat_min,lon_max,lat_max
UAL_BBOX=-82,26,14,68
UAL_MAX_FLIGHTS=80

# OpenSky Network API client (OAuth2 client credentials, created in your OpenSky account page)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Local copy of the OpenSky aircraft metadata CSV, used to map icao24 -> aircraft type and operator.
# Download (90 MB): curl -o data/aircraftDatabase.csv https://s3.opensky-network.org/data-samples/metadata/aircraftDatabase.csv
OPENSKY_AIRCRAFT_DB=data/aircraftDatabase.csv

# Copernicus Climate Data Store. cdsapi also reads ~/.cdsapirc if these are blank.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Contrails.org API: GOES satellite contrail detections, matched to flights in live mode.
# Key from api@contrails.org (sent as the x-api-key header). Leave the key blank to skip attribution.
CONTRAILS_ORG_URL=https://api.contrails.org
CONTRAILS_ORG_KEY=
# Minutes between satellite images fetched (GOES has one every 10 min)
UAL_OBS_STEP_MIN=30

# Where finished scenarios are cached
UAL_CACHE_DIR=.cache
